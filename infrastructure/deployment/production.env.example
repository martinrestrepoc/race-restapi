# This file documents the values assembled on EC2 by deploy-release.sh.
# The three passwords come from encrypted SSM parameters and must never be
# committed in a real production.env file.
AWS_REGION=us-east-1
ECR_REGISTRY=850252650610.dkr.ecr.us-east-1.amazonaws.com
IMAGE_TAG=0123456789abcdef0123456789abcdef01234567
POSTGRES_PASSWORD=replace-with-a-long-random-value
KEYCLOAK_DB_PASSWORD=replace-with-a-different-long-random-value
KEYCLOAK_ADMIN_PASSWORD=replace-with-a-third-long-random-value
